# Copy this file to `.env` and fill in values.

# --- Database ---
# Local development uses a SQLite file. No auth token needed.
TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=

# In production (Vercel), point these at your Turso database instead:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# --- Admin ---
# One shared passcode gates /admin/* (deliberate simplification, see SPEC rule 5).
# Used from Milestone 4 onward. Demo value below is fine to expose to reviewers.
ADMIN_PASSCODE=talentbank2026
