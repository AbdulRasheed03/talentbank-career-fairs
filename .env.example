# Copy this file to `.env` and fill in values.

# --- Database ---
# Local development uses a SQLite file. No auth token needed.
TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=

# In production (Vercel), point these at your Turso database instead:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# --- Auth ---
# Secret used to sign session cookies. SESSION_SECRET is preferred; if unset it
# falls back to ADMIN_PASSCODE so the demo works without extra config.
# SESSION_SECRET=change-me-in-production
#
# ADMIN_PASSCODE also happens to be the seeded admin account's password.
# Sign in at /login as  admin / talentbank2026  (see README). Fine to expose here.
ADMIN_PASSCODE=talentbank2026
